{
  "name": "resolve-api",
  "version": "1.0.0",
  "description": "Node.js + Express + MongoDB API",
  "main": "src/server.ts",
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "nodemon --watch src --ext ts --exec \"tsx src/server.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate:article-authors": "tsx src/scripts/migrateArticleAuthors.ts",
    "migrate:billing-roles": "tsx src/scripts/migrateBillingRoles.ts",
    "migrate:categories": "tsx src/scripts/migrateCategories.ts",
    "migrate:research-requests": "tsx src/scripts/researchRequests/migrate.ts",
    "resync:poll-counts": "tsx src/scripts/resyncPollCounts.ts",
    "public-pulse:transitions": "tsx src/scripts/runPublicPulseTransitions.ts",
    "comments:ban-sweeper": "tsx src/scripts/runCommentBanSweeper.ts",
    "comments:seed-blocked-keywords": "tsx src/scripts/seedBlockedKeywords.ts",
    "comments:resync-counts": "tsx src/scripts/resyncCommentCounts.ts",
    "migrate:regions": "tsx src/scripts/migrateRegions.ts",
    "migrate:ai-summary": "tsx src/scripts/migrateAiSummary.ts",
    "migrate:chat-message-model": "tsx src/scripts/migrateChatMessageModel.ts",
    "migrate:poll-open-status": "tsx src/scripts/migratePollOpenStatus.ts",
    "migrate:unset-poll-results-mode": "tsx src/scripts/unsetPollResultsMode.ts",
    "backfill:embeddings": "tsx src/scripts/backfillEmbeddings.ts",
    "seed:articles": "tsx src/scripts/seedArticles.ts",
    "create:vector-index": "tsx src/scripts/createVectorIndex.ts",
    "check:narration": "tsx src/scripts/checkAnswerNarration.ts",
    "reseed:schedule": "tsx src/scripts/reseedArticleSchedule.ts",
    "test": "tsx --test --experimental-test-module-mocks \"src/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@clerk/backend": "^3.4.14",
    "@clerk/express": "^2.1.22",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.1",
    "resend": "^6.12.4",
    "socket.io": "^4.8.3",
    "svix": "^1.95.1",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "nodemon": "^3.1.9",
    "typescript": "^6.0.3"
  }
}
